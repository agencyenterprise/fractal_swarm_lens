# Copy to .env locally. Never commit populated credentials.
OPENAI_API_KEY=your_openai_api_key_here

# Requested MAST judge. The upstream notebook used o1; reports record this model variant.
MAST_MODEL=gpt-5.5
# Imported traces keep each saved agent's model; this is the fallback when absent.
SWARM_LENS_CONTINUATION_MODEL=gpt-5.5
# Set the context window explicitly if selecting a different, unrecognized model.
# MAST_CONTEXT_WINDOW=1050000

# Timeline plugin model; both methods (single call and summary tree) use the same one.
TIMELINE_MODEL=gpt-5.6-sol
TIMELINE_REASONING_EFFORT=medium
# TIMELINE_CONTEXT_WINDOW=1050000

# Requested CASPIAN encoder. Dimensions are an experimental setting, not from the paper.
CASPIAN_EMBEDDING_MODEL=text-embedding-3-small
CASPIAN_EMBEDDING_DIMENSIONS=16
