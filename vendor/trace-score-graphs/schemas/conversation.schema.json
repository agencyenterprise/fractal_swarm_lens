{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarm-lens.local/schemas/conversation-v1.json",
  "title": "Normalized conversation instance",
  "type": "object",
  "required": [
    "schema_version",
    "conversation_id",
    "raw_sha256",
    "adapter",
    "source_framework",
    "task",
    "actors",
    "events",
    "coverage",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "events-v1"
    },
    "conversation_id": {
      "type": "string"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter": {
      "type": "string"
    },
    "source_framework": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "actor",
          "kind",
          "content",
          "recipients",
          "source_span"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "actor": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_span": {
            "type": "object",
            "required": [
              "start",
              "end",
              "line_start",
              "line_end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "coverage": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
